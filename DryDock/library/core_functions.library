    },
    {
      "name": "workflow_orchestrator",
      "description": "Manages multi-step workflows with dependencies and error handling",
      "permissions": ["execute_workflows", "manage_dependencies", "handle_errors", "track_progress"],
      "required_for": [],
      "suitable_for": ["project_manager", "devops"],
      "category": "orchestration",
      "complexity": "advanced",
      "details": {
        "capabilities": [
          "Workflow execution",
          "Dependency resolution",
          "Error handling",
          "Progress tracking"
        ],
        "use_cases": [
          "Complex process automation",
          "Multi-stage operations",
          "Pipeline management",
          "Workflow coordination"
        ]
      }
    }
  ],

  "categories": {
    "essential": "Core functions required for basic agent operation",
    "quality": "Functions that ensure input/output quality",
    "presentation": "Functions for formatting and displaying information",
    "analysis": "Functions for analyzing data, code, or situations",
    "code": "Functions specific to code and software development",
    "testing": "Functions related to test generation and execution",
    "reporting": "Functions for creating reports and summaries",
    "documentation": "Functions for generating documentation",
    "planning": "Functions for planning and task management",
    "orchestration": "Functions for coordinating complex workflows"
  },

  "usage_guidelines": {
    "essential_functions": "Every agent should include context_manager as minimum",
    "role_based_selection": "Choose functions that match the agent's primary role",
    "capability_matching": "Ensure selected functions support defined capabilities",
    "permission_alignment": "Function permissions must align with agent security constraints",
    "complexity_consideration": "Balance functionality with maintainability"
  }
}
