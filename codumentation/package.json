{
  "name": "codumentation",
  "version": "0.1.2",
  "description": "Auto-verifiable Markdown for documentation that cannot rot",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "default": "./dist/helpers.js"
    }
  },
  "bin": {
    "codumentation": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:ci": "vitest run",
    "codumentation:validate": "npx codumentation validate",
    "codumentation:build": "npx codumentation build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "documentation",
    "validation",
    "markdown",
    "ai-context",
    "testing",
    "docs-as-code",
    "ci-cd",
    "llm",
    "claude",
    "ai-agents"
  ],
  "author": "Benque Max AI Lab (https://benquemax.com/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benquemax/codumentation.git"
  },
  "homepage": "https://benquemax.com/codumentation",
  "bugs": {
    "url": "https://github.com/benquemax/codumentation/issues"
  },
  "dependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "commander": "^14.0.2",
    "chalk": "^5.6.2"
  },
  "peerDependencies": {
    "glob": ">=10.0.0"
  },
  "peerDependenciesMeta": {
    "glob": {
      "optional": true
    }
  },
  "devDependencies": {
    "glob": "^13.0.0",
    "@types/node": "^25.0.3",
    "vitest": "^4.0.16",
    "memfs": "^4.14.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
